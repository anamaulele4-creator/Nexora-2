# =====================================================================
# CONNECTOR AI · variáveis de ambiente (EXEMPLO — sem segredos reais)
# Copia para .env e preenche. NUNCA faças commit do .env.
# =====================================================================

# --- Geral -----------------------------------------------------------
ENVIRONMENT=development            # development | test | staging | production
API_BASE_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=                      # origens extra, separadas por vírgula
LOG_LEVEL=INFO
TRUST_FORWARDED_FOR=false          # true só atrás de um proxy de confiança

# --- Base de dados e Redis (docker-compose sobe ambos) ----------------
POSTGRES_USER=connector
POSTGRES_PASSWORD=change-me-local-db-password
POSTGRES_DB=connector_ai
DATABASE_URL=postgresql://connector:change-me-local-db-password@localhost:5432/connector_ai
DATABASE_POOL_MIN=1
DATABASE_POOL_MAX=10
REDIS_URL=redis://localhost:6379/0

# --- Autenticação ------------------------------------------------------
AUTH_PROVIDER=local                # local | supabase
# Gera com:  python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-generate-a-long-random-value-48-chars
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=1209600
REQUIRE_EMAIL_VERIFICATION=true
COOKIE_SECURE=false                # true em produção (https)
COOKIE_DOMAIN=
AUTH_RATE_LIMIT_PER_15MIN=10

# Só com AUTH_PROVIDER=supabase (Etapa 6/7, quando autorizado)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_JWT_SECRET=

# --- Email -------------------------------------------------------------
EMAIL_BACKEND=console              # console (links no log) | smtp
EMAIL_FROM=CONNECTOR AI <no-reply@localhost>
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_STARTTLS=true

# --- Cofre de credenciais de conectores (AES-256-GCM) --------------------
# Gera com:  python -c "import os,base64; print(base64.b64encode(os.urandom(32)).decode())"
CREDENTIALS_ENCRYPTION_KEY=
CREDENTIALS_ENCRYPTION_KEY_ID=k1

# --- Etapas seguintes (deixar vazio na Etapa 1) ---------------------------
OPENAI_API_KEY=                    # Etapa 3
OPENAI_MODEL=gpt-4.1
BROWSERBASE_API_KEY=               # Etapa 2
BROWSERBASE_PROJECT_ID=            # Etapa 2
TEMPORAL_ADDRESS=                  # Etapa 5
S3_ENDPOINT_URL=                   # Etapa 2/5
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# --- Frontend (Next.js) -------------------------------------------------
API_URL=http://localhost:8000      # para onde o Next reencaminha /api/*
