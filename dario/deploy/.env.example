# =====================================================================
# DÁRIO · variáveis do servidor (EXEMPLO — sem segredos reais)
# cp .env.example .env  e preenche. NUNCA faças commit do .env.
# =====================================================================

# Domínio público da DÁRIO API (o DNS tem de apontar para o IP do VPS). O Caddy obtém o HTTPS sozinho.
DARIO_DOMAIN=dario.teu-dominio.com
ACME_EMAIL=garenadario3@gmail.com

# Tokens (gera cada um com:  openssl rand -hex 32)
#  - DARIO_API_TOKEN: o que colas no /admin da CONNECTOR AI (chat, modelos, memória)
#  - DARIO_ADMIN_TOKEN: só para ti (descarregar/apagar modelos). Também serve no /admin se quiseres gerir modelos de lá.
DARIO_API_TOKEN=
DARIO_ADMIN_TOKEN=

# Base de dados da memória (PostgreSQL + pgvector, só na rede interna)
POSTGRES_PASSWORD=

# Ollama
OLLAMA_MAX_LOADED_MODELS=2          # 12 GB VRAM: um modelo de chat + o de embeddings
OLLAMA_NUM_PARALLEL=2
OLLAMA_KEEP_ALIVE=30m
OLLAMA_CONTEXT_LENGTH=8192

# Model Manager (primeiro instalado da lista ganha)
DARIO_GENERAL_MODELS=qwen3:8b,llama3.1:8b,mistral:7b
DARIO_CODE_MODELS=qwen2.5-coder:7b,qwen3:8b
DARIO_REASONING_MODELS=qwen3:14b,qwen3:8b
DARIO_EMBED_MODEL=nomic-embed-text
DARIO_EMBED_DIM=768
